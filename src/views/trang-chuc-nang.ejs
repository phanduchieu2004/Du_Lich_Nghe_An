<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4f7f5" />
    <title>Các chức năng | Atlas</title>
    <style>
      :root {
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #1b302c;
        background: #f4f7f5;
        --green: #14836e;
        --muted: #74837f;
        --line: #e4ebe7;
      }
      * { box-sizing: border-box; }
      body { margin: 0; min-width: 320px; }
      header { height: 68px; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; background: #fff; border-bottom: 1px solid var(--line); }
      a { color: inherit; text-decoration: none; }
      .brand { display: flex; align-items: center; gap: 12px; font-weight: 800; }
      .brand-mark { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 11px; color: white; background: var(--green); }
      .back { color: var(--green); font-size: 13px; font-weight: 700; }
      main { width: min(880px, calc(100% - 36px)); margin: 52px auto; }
      .eyebrow { margin: 0 0 8px; color: var(--green); font-size: 11px; font-weight: 800; letter-spacing: 1.3px; }
      h1 { margin: 0; font-size: clamp(24px, 4vw, 34px); }
      .description { margin: 10px 0 28px; color: var(--muted); font-size: 14px; line-height: 1.7; }
      .function-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
      .function-card { display: grid; gap: 14px; padding: 20px; border: 1px solid var(--line); border-radius: 13px; background: #fff; }
      .function-card p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.6; }
      .location-button { display: inline-flex; width: fit-content; min-height: 40px; align-items: center; justify-content: center; padding: 0 14px; border: 0; border-radius: 9px; background: var(--green); color: #fff; font-size: 12px; font-weight: 700; }
      .location-button:hover { background: #0c6d5b; }
      @media (max-width: 520px) {
        header { padding: 0 15px; }
        main { margin-top: 32px; }
      }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href="/" aria-label="Về trang chủ Atlas">
        <span class="brand-mark">A</span>
        <span>Atlas</span>
      </a>
      <a class="back" href="/">Về trang chủ</a>
    </header>
    <main>
      <p class="eyebrow">KHO CHỨC NĂNG</p>
      <h1>Các chức năng</h1>
      <p class="description">Chọn chức năng cần sử dụng. Các nút được quản lý tập trung trong thư mục <code>src/nut-chuc-nang</code>.</p>
      <section class="function-list" aria-label="Danh sách chức năng">
        <article class="function-card">
          <p>Quản lý, tìm kiếm và nhập dữ liệu cho các bảng trong cơ sở dữ liệu.</p>
          <%- include('../nut-chuc-nang/danh-sach', { buttonIds }) %>
        </article>
      </section>
    </main>
  </body>
</html>
